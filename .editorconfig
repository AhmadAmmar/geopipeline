# Purpose: Declare that this is the top-most EditorConfig file for the repository.
root = true

# Purpose: Apply baseline text rules to most files in the project.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Purpose: Python files conventionally use 4-space indentation.
[*.py]
indent_size = 4

# Purpose: Markdown often intentionally keeps trailing spaces for line breaks.
[*.md]
trim_trailing_whitespace = false